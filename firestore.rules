rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasCollege() { return signedIn() && request.auth.token.get('collegeId', null) is string && request.auth.token.collegeId.size() > 0; }
    function sameCollege(data) { return hasCollege() && data.get('collegeId', null) == request.auth.token.collegeId; }
    function staff() { return signedIn() && request.auth.token.get('role', '') in ['PLACEMENT_OFFICER', 'SUPER_ADMIN']; }
    function admin() { return signedIn() && request.auth.token.get('role', '') == 'SUPER_ADMIN'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function opportunityPath(id) { return /databases/$(database)/documents/opportunities/$(id); }
    function visibleOpportunity(id) {
      return exists(opportunityPath(id)) && sameCollege(get(opportunityPath(id)).data)
        && get(opportunityPath(id)).data.get('isVerified', false) == true;
    }

    match /users/{uid} {
      allow get: if owner(uid) || (staff() && sameCollege(resource.data));
      allow list: if staff() && sameCollege(resource.data);
      allow create: if owner(uid)
        && request.auth.token.get('role', 'STUDENT') == 'STUDENT'
        && request.resource.data.keys().hasOnly(['uid','name','email','role','institution','createdAt'])
        && request.resource.data.keys().hasAll(['uid','name','email','role','institution','createdAt'])
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.get('email', null)
        && request.resource.data.role == 'STUDENT' && text(request.resource.data.name, 200)
        && text(request.resource.data.institution, 200) && request.resource.data.createdAt is int;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','institution'])
        && text(request.resource.data.name, 200) && text(request.resource.data.institution, 200);
      allow delete: if false;

      match /savedPlacements/{opportunityId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && visibleOpportunity(opportunityId)
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.keys().hasAll(['savedAt']) && request.resource.data.savedAt is timestamp;
      }
    }

    // Publishing and verification are performed by trusted backend code, not clients.
    match /companies/{id} {
      allow read: if sameCollege(resource.data) && resource.data.get('approved', false) == true;
      allow write: if false;
    }
    match /placementDrives/{id} {
      allow read: if sameCollege(resource.data) && (staff() || resource.data.get('verified', false) == true);
      allow write: if false;
    }
    match /opportunities/{id} {
      allow read: if sameCollege(resource.data) && (staff() || resource.data.get('isVerified', false) == true);
      allow write: if false;
    }
    match /verificationRequests/{id} {
      allow read: if staff() && sameCollege(resource.data);
      // Verification state is changed only by the trusted review callable.
      allow create, update: if false;
      allow delete: if false;
    }
    match /notifications/{id} {
      allow read: if sameCollege(resource.data) && resource.data.get('userId', '') == request.auth.uid;
      allow update: if sameCollege(resource.data) && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
      allow create, delete: if false;
    }
    match /applications/{id} {
      allow read: if sameCollege(resource.data) && (resource.data.get('userId', '') == request.auth.uid || staff());
      allow create: if sameCollege(request.resource.data) && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','collegeId','opportunityId','opportunityTitle','companyName','appliedDate','status','ctc'])
        && request.resource.data.keys().hasAll(['userId','collegeId','opportunityId','opportunityTitle','companyName','appliedDate','status','ctc'])
        && text(request.resource.data.opportunityId, 200) && visibleOpportunity(request.resource.data.opportunityId)
        && text(request.resource.data.opportunityTitle, 300) && text(request.resource.data.companyName, 200)
        && text(request.resource.data.appliedDate, 100) && request.resource.data.status == 'Applied'
        && request.resource.data.ctc is string && request.resource.data.ctc.size() <= 200;
      allow update, delete: if false;
    }
    match /misinformationReports/{id} {
      allow read: if sameCollege(resource.data) && (staff() || resource.data.get('reportedBy', '') == request.auth.uid);
      allow create: if sameCollege(request.resource.data) && request.resource.data.get('reportedBy', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['collegeId','title','companyName','reportedBy','reason','status','date'])
        && request.resource.data.keys().hasAll(['collegeId','title','companyName','reportedBy','reason','status','date'])
        && text(request.resource.data.title, 300) && text(request.resource.data.companyName, 200)
        && text(request.resource.data.reason, 3000) && text(request.resource.data.date, 100)
        && request.resource.data.status == 'Pending';
      allow update: if staff() && sameCollege(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Pending','Investigating','Resolved','Dismissed'];
      allow delete: if false;
    }
    match /interviewResearch/{opportunityId} {
      allow read: if visibleOpportunity(opportunityId);
      allow write: if false;
    }
    match /researchJobs/{job} {
      allow read: if sameCollege(resource.data);
      allow write: if false;
    }
    match /preparationKits/{kit} {
      // The client probes the deterministic kit ID before a job exists.
      allow get: if hasCollege() && (!exists(/databases/$(database)/documents/preparationKits/$(kit)) || sameCollege(resource.data));
      allow list: if sameCollege(resource.data);
      allow write: if false;
      match /{items}/{item} {
        allow read: if items in ['interviewQuestions','interviewExperiences']
          && sameCollege(get(/databases/$(database)/documents/preparationKits/$(kit)).data);
        allow write: if false;
      }
    }
    match /studentPreparationProgress/{uid}/questions/{question} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['bookmarked','completed','updatedAt'])
        && request.resource.data.keys().hasAll(['bookmarked','completed','updatedAt'])
        && request.resource.data.bookmarked is bool && request.resource.data.completed is bool
        && request.resource.data.updatedAt is timestamp;
    }
    // All other paths, including provider state and rate limits, are denied to clients.
  }
}
